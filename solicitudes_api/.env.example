# ---- MySQL (host/puerto vistos DESDE el servidor SSH) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tech_nueva_eps
DB_USER=TU_USUARIO_MYSQL
DB_PASSWORD=TU_CLAVE_MYSQL

# ---- Túnel SSH (dejar SSH_HOST vacío para conectarse directo, sin túnel) ----
SSH_HOST=IP_DEL_SERVIDOR
SSH_PORT=22
SSH_USER=ubuntu
# Llave en formato OpenSSH (.pem). Una .ppk se convierte con:
#   puttygen llave.ppk -O private-openssh -o llave.pem
SSH_PRIVATE_KEY=C:\ruta\a\llave.pem
SSH_KEY_PASSPHRASE=
# DEBE ser la misma clave en auth_api y solicitudes_api
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
FRONTEND_ORIGIN=http://localhost:5173

# Nivel de logs: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
