# =============================================================
#  Configuración única del proyecto (Docker Compose, ambas APIs y frontend)
#  Copiar a .env:   copy .env.example .env
# =============================================================

# ---- Base de datos ----
# Con Docker, DB_HOST y DB_PORT se reemplazan automáticamente por el contenedor "db".
DB_HOST=127.0.0.1
DB_PORT=3306
# Debe coincidir con el nombre usado en database/schema.sql
DB_NAME=tech_nueva_eps
# Con Docker este usuario se crea automáticamente (no usar "root")
DB_USER=eps_app
DB_PASSWORD=cambia_esta_clave

# Solo Docker: clave de root del contenedor MySQL y puerto del host (para DBeaver)
DB_ROOT_PASSWORD=cambia_esta_clave_root
DB_EXPOSED_PORT=3306

# ---- Seguridad (la misma clave firma y verifica el token en ambas APIs) ----
# ---- Generarla con el siguiente comando: python -c "import secrets; print(secrets.token_urlsafe(48))" ----
SECRET_KEY=cambia_esta_clave_por_una_larga_y_aleatoria
TOKEN_EXPIRE_MINUTES=120
FRONTEND_ORIGIN=http://localhost:5173

# Nivel de logs: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ---- Frontend (URLs que usa el navegador) ----
VITE_AUTH_API_URL=http://localhost:8001
VITE_SOLICITUDES_API_URL=http://localhost:8002
# Solicitudes por página en el listado (1 a 100)
VITE_PAGE_SIZE=5
